{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "github-actions"
  ],
  "labels": [
    "dependencies"
  ],
  "schedule": [
    "before 5am on monday"
  ],
  "packageRules": [
    {
      "description": "Patch updates are merged automatically",
      "matchUpdateTypes": ["patch"],
      "automerge": true
    }
  ]
}
